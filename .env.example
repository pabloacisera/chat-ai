# --- CHAT IA - Variables de Entorno ---

# Puerto del servidor Express (default: 3000)
EXPRESS_PORT=3001

# --- Base de Datos ---
# PostgreSQL (Supabase o similar)
DATABASE_URL=postgresql://usuario:password@host:5432/chatdb

# Redis (Upstash o similar)
REDIS_URL=redis://usuario:password@host:6379

# --- Seguridad ---
# Secretos para JWT y encriptación
# Generar con: openssl rand -hex 64
JWT_SECRET=<generar con: openssl rand -hex 64>
ENCRYPTION_KEY=<generar con: openssl rand -hex 64>

# --- CORS ---
# Origen permitido para CORS (default: todos)
CORS_ORIGIN=*
